{
  "name": "liquidez-diaria-2",
  "compatibility_date": "2024-09-23",
  "main": "src/index.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS"
  },
  // Dispara scheduled() en src/index.js cada 5 minutos para el barrido de
  // alertas push (ejecutarBarridoAlertas). Es seguro tenerlo activo aunque
  // el KV namespace de abajo todavía no exista: la función comprueba
  // `env.PUSH_SUBS` y no hace nada si el binding no está configurado.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  // KV namespace para guardar las suscripciones push (creado en el
  // dashboard de Cloudflare el 2026-08-21). El secreto VAPID_PRIVATE_KEY_JWK
  // correspondiente a VAPID_PUBLIC_KEY (src/index.js) / vapidPublicKey
  // (lib/manifest.js) se configuró aparte en Configuración → Variables y
  // secretos, ya que wrangler.jsonc no debe contener secretos.
  "kv_namespaces": [
    { "binding": "PUSH_SUBS", "id": "c9ff4e5cf5bf473788f1af2156ed7319" }
  ]
}

